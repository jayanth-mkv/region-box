{
  "name": "regionbox",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:public": "node scripts/check-public.mjs && node scripts/scan-secrets.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --lib --features tauri/custom-protocol",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:onboarding": "npm run build && node scripts/test-onboarding.mjs",
    "test:viewer": "node scripts/test-viewer.mjs",
    "desktop:prototype": "tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
